# Contoh environment variables — salin jadi .env lalu sesuaikan
# cp .env.example .env

# ── WAJIB PRODUKSI ─────────────────────────────────────────────────
# Secret untuk menandatangani sesi admin (JWT HS256).
# WAJIB diisi di produksi (Vercel/cPanel) — tanpa ini login admin DITOLAK.
# Generate: openssl rand -hex 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ── Database (pilih salah satu sesuai deployment) ──────────────────
# Vercel / server dengan PostgreSQL:
POSTGRES_URL="postgresql://user:password@host:5432/dbname"

# Hosting file-based (cPanel / VPS) — ganti provider di prisma/schema.prisma
# menjadi "sqlite" terlebih dahulu, lalu:
# DATABASE_URL="file:./db/custom.db"
